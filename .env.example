# Optix app credentials — from the Optix admin dashboard → Apps → Develop
CLIENT_ID=your_client_id_here
CLIENT_SECRET=your_client_secret_here

# Organization token — delivered via app_install webhook and stored by tokenStore
# You can also seed this with the token from the admin dashboard for initial setup
ORG_TOKEN=your_org_token_here

# Server config
PORT=3000

# Public base URL for this server (used to build webhook URLs in settings.json)
# For local dev: use your ngrok URL, e.g. https://abc123.ngrok.io
WEBHOOK_BASE_URL=https://your-server.example.com
